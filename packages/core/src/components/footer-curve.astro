---
import './footer-curve.css'

import type { FooterCurveShape } from '../config/variants.ts'
import { buildFooterCurve } from '../lib/portfolio/footer-curve.ts'

// decorative curved top edge of the inner footer, a port of the legacy theme's `do_footer_curve`
// (curve.php) + `_footer.scss`; the transparent areas show the band's own background, so the colors
// come from theme tokens and follow light and dark mode
type Props = {
	shape: FooterCurveShape
	height: number
}

const { shape, height } = Astro.props
const curve = buildFooterCurve(shape, height)
---

<div
	class:list={['footer-curve', { 'footer-curve--inverse': curve.inverse }]}
	style={`height:${curve.height}px`}
	aria-hidden="true"
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		version="1.1"
		width="100%"
		height={`${curve.height}px`}
		viewBox={curve.viewBox}
		preserveAspectRatio="none"
	>
		<path d={curve.path}></path>
	</svg>
</div>
