---
import AlbumCards from '../../../components/portfolio/album-cards.astro'
import AlbumList from '../../../components/portfolio/album-list.astro'
import GalleryAside from '../../../components/portfolio/gallery-aside.astro'
import type { Locale } from '../../../config/locale-schema.ts'
import { site } from '../../../config/site.ts'
import { siteRoot } from '../../../config/site-root.ts'
import { useTranslations } from '../../../i18n/ui.ts'
import Base from '../../../layouts/base.astro'
import { resolveBanner } from '../../../lib/banner/build-data.ts'
import { localizedStaticPaths } from '../../../lib/content/routes.ts'
import { loadImageCatalog } from '../../../lib/images/catalog.ts'
import { loadPublishedPortfolio } from '../../../lib/portfolio/build-data.ts'
import { bannerPhotoId, footerPromoContext } from '../../../lib/portfolio/footer-promo-build.ts'
import { buildLocaleMeta } from '../../../lib/portfolio/page-meta.ts'
import { resolveAlbumCover } from '../../../lib/portfolio/publication.ts'

export function getStaticPaths() {
	return localizedStaticPaths(site.content.locales)
}

type Props = { locale: Locale }

const { locale } = Astro.props
const t = useTranslations(locale)
const catalog = loadImageCatalog(siteRoot)
const { albums, photosById } = await loadPublishedPortfolio()
const banner = await resolveBanner({ kind: 'surface', surface: 'portfolioIndex' }, locale, site)
const meta = buildLocaleMeta(Astro.url.pathname, Astro.site!.href, site.content.locales)
const more = site.listing.moreLink === 'on' ? t('listing.more') : undefined
const footerPromo = footerPromoContext(
	'surface:portfolio-index',
	bannerPhotoId(banner),
	albums.map((album) => resolveAlbumCover(album, photosById).id),
)
---

<Base
	footerPromo={footerPromo}
	title={t('nav.portfolio')}
	canonical={meta.canonical}
	alternates={meta.alternates}
	width={site.surfaces.portfolioIndex.width}
	heading={t('nav.portfolio')}
	banner={banner}
>
	<GalleryAside>
		<AlbumList slot="aside" albums={albums} locale={locale} label={t('portfolio.albums')} />
		<AlbumCards
			catalog={catalog}
			albums={albums}
			photosById={photosById}
			locale={locale}
			more={more}
			presentation={site.portfolio.card}
		/>
	</GalleryAside>
</Base>
