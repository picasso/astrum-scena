{
	"name": "astrum-scena-workspace",
	"version": "1.6.10",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.14.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm --filter @picasso-ai/astrum-scena build && pnpm --filter astrum-scena-demo build",
		"release": "node --experimental-strip-types scripts/release.ts",
		"demo:packed": "node --experimental-strip-types scripts/build-demo-from-pack.ts",
		"test:e2e": "node --experimental-strip-types scripts/run-e2e.ts",
		"test:e2e:docker": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -v /work/packages/core/node_modules -v /work/demo/node_modules -v /work/.cache -w /work mcr.microsoft.com/playwright:v1.61.1-noble@sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48 bash -lc \"corepack enable && pnpm install --frozen-lockfile && pnpm test:e2e\"",
		"test:e2e:docker:update": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -v /work/packages/core/node_modules -v /work/demo/node_modules -v /work/.cache -w /work mcr.microsoft.com/playwright:v1.61.1-noble@sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48 bash -lc \"corepack enable && pnpm install --frozen-lockfile && pnpm test:e2e --update-snapshots\"",
		"check": "node --experimental-strip-types scripts/check.ts",
		"typecheck": "tsc --noEmit && pnpm --filter @picasso-ai/astrum-scena build && pnpm --filter astrum-scena-demo typecheck && pnpm --filter @picasso-ai/astrum-scena typecheck",
		"test": "vitest run",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"config:resolve": "pnpm --filter astrum-scena-demo config:resolve",
		"layout:tokens": "pnpm --filter astrum-scena-demo layout:tokens",
		"demo:images": "node --experimental-strip-types scripts/generate-demo-images.ts",
		"check:site": "pnpm --filter astrum-scena-demo check:site",
		"check:image-files": "pnpm --filter astrum-scena-demo check:image-files",
		"check:config-lock": "pnpm --filter astrum-scena-demo check:config-lock",
		"check:layout-tokens": "pnpm --filter astrum-scena-demo check:layout-tokens",
		"check:color-literals": "pnpm --filter astrum-scena-demo check:color-literals",
		"check:css-layers": "pnpm --filter astrum-scena-demo check:css-layers",
		"check:pages": "pnpm --filter astrum-scena-demo check:pages",
		"check:images-policy": "pnpm --filter astrum-scena-demo check:images-policy",
		"check:images-public-config": "pnpm --filter astrum-scena-demo check:images-public-config",
		"check:place-gps-bounds": "pnpm --filter astrum-scena-demo check:place-gps-bounds",
		"check:content": "pnpm --filter astrum-scena-demo check:content",
		"check:factcheck": "pnpm --filter astrum-scena-demo check:factcheck",
		"check:skills": "pnpm --filter astrum-scena-demo check:skills",
		"check:core-version": "pnpm --filter astrum-scena-demo check:core-version",
		"check:code-comments": "node --experimental-strip-types scripts/check-code-comments.ts",
		"check:taxonomy-readers": "node --experimental-strip-types scripts/check-taxonomy-readers.ts",
		"api:snapshot": "node --experimental-strip-types scripts/api-snapshot.ts --update",
		"check:api-snapshot": "node --experimental-strip-types scripts/check-api-snapshot.ts",
		"check:api-breaking": "node --experimental-strip-types scripts/check-api-breaking.ts",
		"check:upgrading": "node --experimental-strip-types scripts/check-upgrading.ts",
		"check:notices": "node --experimental-strip-types scripts/check-notices.ts",
		"lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\" \"!**/dist/**\" \"!**/.astro/**\" \"!.claude/**\" \"!.agents/**\" \"!_bmad/**\" \"!_bmad-output/**\" \"!playwright-report/**\" \"!test-results/**\" \"!.cache/**\"",
		"check:identity": "node --experimental-strip-types --env-file-if-exists=.env scripts/check-identity.ts",
		"check:local-paths": "node --experimental-strip-types scripts/check-local-paths.ts",
		"check:publication-tree": "node --experimental-strip-types --env-file-if-exists=.env scripts/publication-tree.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@types/node": "^24.13.3",
		"astro-eslint-parser": "^3.2.0",
		"eslint": "^10.13.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-check-file": "^3.3.2",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"husky": "^9.1.7",
		"markdownlint-cli2": "^0.23.1",
		"postcss": "^8.5.31",
		"prettier": "^3.9.5",
		"prettier-plugin-astro": "^0.14.1",
		"sharp": "0.35.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^4.1.10",
		"yaml": "^2.9.1"
	}
}
